# Application
APP_NAME="Question Paper Setting Agent"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8501
SECRET_KEY="replace-with-a-long-random-local-secret"

# LLM provider (groq | openrouter | nvidia_nim | ollama | custom_openai_compatible | mock)
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your-api-key-here"
LLM_TEMPERATURE_GENERATION=0.4
LLM_TEMPERATURE_VALIDATION=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Provider-specific optional keys
GROQ_API_KEY="your-groq-api-key-here"
OPENROUTER_API_KEY=""
NVIDIA_NIM_API_KEY=""
OLLAMA_API_KEY="ollama"

# Optional OpenRouter configuration
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL=""
OPENROUTER_SITE_URL="http://localhost:8501"
OPENROUTER_APP_NAME="Question Paper Setting Agent"

# Optional NVIDIA NIM configuration
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL=""

# Optional Local Ollama & Qwen Model configuration
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3:8b"

# Local mock mode - set true to run without API key
USE_MOCK_LLM=false

# Database
DATABASE_URL="sqlite:///./data/database/qp_agent.db"

# Similarity
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
SEMANTIC_DUPLICATE_THRESHOLD=0.88
SEMANTIC_WARNING_THRESHOLD=0.80

# Paper rules
DEFAULT_BLOOM_L2_PERCENT=50
DEFAULT_BLOOM_L3_PERCENT=50
DEFAULT_RATIO_TOLERANCE_PERCENT=5
MAX_PAPER_SETS=5

# Security and logging
LOG_LEVEL="INFO"
LOG_PROMPT_CONTENT=false
STORE_LLM_RAW_RESPONSES=false
